# Copiar a .env y configurar para el servidor local.
# Base y clave del usuario app_backend_user definidos en RE-db.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=repuestos_exactos
DB_USER=app_backend_user
DB_PASSWORD=REEMPLAZAR_CON_APP_BACKEND_PASSWORD
# disable solo para el contenedor local sin TLS. Remoto: verify-full.
DB_SSL_MODE=disable

# Orígenes exactos del frontend web, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
